{
  "name": "docstar-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.swayammaheshwari/docstar-mcp",
  "description": "Remote MCP server that lets AI clients (Claude, ChatGPT) read, search, create and publish DocStar docs via the DocStar API.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
